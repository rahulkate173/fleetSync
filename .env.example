# fleetSync Environment Variables
# Copy to .env and fill in your values

# Server
DATABASE_URL=sqlite:///./fleetsync.db
# For PostgreSQL: postgresql://user:pass@host:5432/fleetsync

# Kafka (for truck driver GPS stream)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=fleetsync-gps

# Pathway engine
FLEETSYNC_SERVER_URL=http://localhost:8000

# Supabase (optional - for auth)
SUPABASE_URL=https://gbodtorawtdmswhwsquj.supabase.co/
SUPABASE_ANON_KEY=your-anon-key

# ETA / Routing (free options: OSRM, OpenRouteService)
OSRM_BASE_URL=https://router.project-osrm.org
