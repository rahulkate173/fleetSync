DATABASE_URL=sqlite:///./fleetsync.db

KAFKA_BOOTSTRAP_SERVERS=kafka:9092

FLEETSYNC_SERVER_URL=${{RAILWAY_STATIC_URL}}

OSRM_BASE_URL=https://router.project-osrm.org
OPENROUTESERVICE_API_KEY=your_api_key_here

VITE_API_URL=${{RAILWAY_STATIC_URL}}

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=fleetsync-gps-3
KAFKA_GROUP_ID=pathway-fleetsync-gps

FLEETSYNC_SERVER_URL=https://server-production-cd13.up.railway.app/
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./fleetsync.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/fleetsync

SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

GPS_VALIDATION_ENABLED=true
TEMPERATURE_EXCURSION_MAX=50
TEMPERATURE_EXCURSION_MIN=-20
SPEED_MAX_KMH=150

# ============================================================================
# PATHWAY GPS PROCESSOR CONFIGURATION
# ============================================================================
POST_TIMEOUT=5.0
RETRY_ATTEMPTS=3
BATCH_SIZE=100
PROCESSING_TIMEOUT=30
LOG_FORMAT=json
LOG_FILE=./logs/fleetsync.log

ENVIRONMENT=development
# Options: development, staging, production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@fleetsync.com

SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false
SENTRY_DSN=
SENTRY_ENABLED=false
MONITORING_ENABLED=true